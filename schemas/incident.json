{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Incident",
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["NEW", "INVESTIGATING", "RESOLVED", "CLOSED"]
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_events": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendation": {
      "type": "string"
    }
  },
  "required": ["incident_id", "title", "status"]
}
