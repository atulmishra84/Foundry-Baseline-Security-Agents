{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "A2A Message",
  "properties": {
    "message_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "from_agent": {
      "type": "string",
      "enum": ["security-engineer", "red-team", "runtime-soc", "orchestrator"]
    },
    "to_agent": {
      "type": "string",
      "enum": ["security-engineer", "red-team", "runtime-soc", "orchestrator"]
    },
    "intent": {
      "type": "string",
      "enum": [
        "DISCOVERY_COMPLETE",
        "ASSESS_COMPLETE",
        "ATTACK_COMPLETE",
        "INCIDENT_RAISED",
        "REMEDIATION_READY",
        "HANDOFF"
      ]
    },
    "payload_ref": { "type": "string" },
    "summary": { "type": "string" }
  },
  "required": ["message_id", "correlation_id", "from_agent", "to_agent", "intent"]
}
