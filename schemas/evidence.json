{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Evidence",
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tool": {
      "type": "string"
    },
    "request": {
      "type": "string"
    },
    "response": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["evidence_id", "asset_id", "timestamp", "source"]
}
