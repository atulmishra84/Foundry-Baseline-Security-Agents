{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Attack",
  "properties": {
    "finding_id": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "attack_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "exploitability": {
      "type": "string",
      "enum": ["UNTESTED", "CONFIRMED", "BLOCKED"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "string"
    },
    "reproduction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_control": {
      "type": "string"
    }
  },
  "required": ["finding_id", "target", "attack_type"]
}
